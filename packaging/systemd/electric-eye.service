[Unit]
Description=Electric Eye system activity monitor
Documentation=https://github.com/jamesmcm/electric-eye
After=systemd-sysusers.service sys-kernel-tracing.mount sys-kernel-debug.mount
ConditionPathExists=|/sys/kernel/tracing/events
ConditionPathExists=|/sys/kernel/debug/tracing/events

[Service]
Type=simple
ExecStart=/usr/bin/electric-eyed
Restart=on-failure
RestartSec=2s
TimeoutStopSec=5s
# Structured startup/incident records go directly to journald. Per-event
# stdout would otherwise copy every captured syscall into the journal.
StandardOutput=null
StandardError=journal

# Runtime socket: /run/electric-eye/electric-eye.sock
RuntimeDirectory=electric-eye
RuntimeDirectoryMode=0750
StateDirectory=electric-eye
StateDirectoryMode=0750
RemoveIPC=yes

# The collector needs BPF/perf access, tracefs reads and /proc/<pid>/exe
# access for processes owned by other users. It runs as an unprivileged
# system user with only those capabilities.
User=electric-eye
Group=electric-eye
SupplementaryGroups=systemd-journal
AmbientCapabilities=CAP_BPF CAP_PERFMON CAP_DAC_READ_SEARCH CAP_SYS_PTRACE
CapabilityBoundingSet=CAP_BPF CAP_PERFMON CAP_DAC_READ_SEARCH CAP_SYS_PTRACE
NoNewPrivileges=yes

# Filesystem and kernel hardening
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
DevicePolicy=closed
DeviceAllow=/dev/null rw
DeviceAllow=/dev/urandom r
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service bpf perf_event_open
SystemCallErrorNumber=EPERM
UMask=0077

[Install]
WantedBy=multi-user.target
